# Vorlage für .env / .env.local (siehe lib/env.ts für die Validierung).
# Diese Datei enthält keine echten Werte und wird eingecheckt; .env selbst nicht (.gitignore).

# Vom postgres-Image in docker-compose.yml gelesen (Container-Zugangsdaten). Nur lokal relevant.
POSTGRES_USER=velora
POSTGRES_PASSWORD=velora
POSTGRES_DB=velora

# Pflicht. Verbindung zur PostgreSQL-Datenbank, muss mit postgres:// oder postgresql:// beginnen.
# Lokale Entwicklung passend zu den POSTGRES_*-Werten oben und docker-compose.yml:
DATABASE_URL=postgresql://velora:velora@localhost:5432/velora

# Optional, Standard "development". In Tests setzt Vitest automatisch "test".
NODE_ENV=development

# Pflicht (Phase 1). Signiert/verschlüsselt Sitzungen, Tokens und Cookies bei better-auth.
# Mindestens 32 zufällige Zeichen, z. B. per `openssl rand -base64 32` erzeugen. Niemals
# wiederverwenden oder einchecken — nur lokal/im Secret-Manager der Zielumgebung setzen.
BETTER_AUTH_SECRET=

# Pflicht (Phase 1). Öffentlich erreichbare Basis-URL dieser Anwendung, ohne Pfad und ohne
# abschließenden Schrägstrich. better-auth leitet daraus u. a. die OAuth-Callback-URLs ab
# (${BETTER_AUTH_URL}/api/auth/callback/<provider>) und ob Cookies das __Secure-Präfix
# bekommen (nur bei https://).
# Lokal:      BETTER_AUTH_URL=http://localhost:3000
# Produktion: BETTER_AUTH_URL=https://velora.example.com
BETTER_AUTH_URL=http://localhost:3000

# Optional. E-Mail-Adresse, die beim Seed-Schritt (`npm run db:seed`) automatisch Admin-Rechte
# erhält, sofern zu diesem Zeitpunkt bereits ein Konto mit dieser E-Mail existiert. Muss, wenn
# gesetzt, eine gültige E-Mail-Adresse sein. Admin-Rechte werden ausschließlich hier vergeben,
# nie über die Anwendung selbst.
ADMIN_BOOTSTRAP_EMAIL=

# Optional, paarweise: OAuth-Zugangsdaten je Provider. ID und Secret müssen zusammen gesetzt
# sein (lib/env.ts lehnt eine halbe Konfiguration ab) — ohne beide bleibt der jeweilige Provider
# inaktiv und taucht in server/auth/providers.ts nicht als aktivierter Anmeldeweg auf.
# Callback-URL beim Provider eintragen (siehe BETTER_AUTH_URL oben für die Basis-URL):
#   Google:  ${BETTER_AUTH_URL}/api/auth/callback/google
#   GitHub:  ${BETTER_AUTH_URL}/api/auth/callback/github
#   Discord: ${BETTER_AUTH_URL}/api/auth/callback/discord
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=

# Optional, standardmäßig leer. Kommagetrennte Liste vertrauenswürdiger Reverse-Proxy-IPs/CIDR-
# Bereiche (z. B. 10.0.0.0/8 oder eine feste Load-Balancer-IP), die den X-Forwarded-For-Header
# glaubwürdig setzen. Steuert ausschließlich das IP-basierte Login-Rate-Limit
# (server/auth/rate-limit-plugin.ts) — NICHT irgendeine Zugriffskontrolle.
#
# WARUM LEER LASSEN SICHERER IST ALS EIN FALSCHER WERT: Ohne bekannte Proxy-Topologie kann
# better-auth nicht unterscheiden, ob X-Forwarded-For von einem echten vorgeschalteten Proxy
# stammt oder frei vom Angreifer erfunden ist — ein einzelner, unverketteter Header-Wert würde
# sonst ungeprüft als Client-IP übernommen. Bleibt diese Variable leer, wird das IP-Limit deshalb
# bewusst DEAKTIVIERT (nur das E-Mail-Limit gilt weiter, siehe server/auth/rate-limit.ts) und die
# Anwendung protokolliert das beim Start einmalig. Ein FALSCH gesetzter Wert (z. B. ein zu weit
# gefasster Bereich oder eine IP, die gar nicht der tatsächlich vorgeschaltete Proxy ist) ist
# gefährlicher als gar keiner: er würde dem Angreifer erlauben, seine eigene, frei wählbare
# "Client-IP" im X-Forwarded-For-Header vorzugeben und damit das IP-Limit gezielt zu umgehen oder
# andere Nutzer fälschlich sperren zu lassen.
#
# Was hier eintragen: NUR die tatsächliche(n) IP(s) des unmittelbar vorgeschalteten,
# selbst betriebenen/kontrollierten Reverse-Proxys (z. B. Load Balancer, CDN-Edge mit
# bekanntem Ausgangs-IP-Bereich) — niemals ein öffentlich erreichbarer/geratener Bereich.
# Beispiel: TRUSTED_PROXY_IPS=10.0.0.0/8
TRUSTED_PROXY_IPS=
