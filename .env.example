# Vorlage für .env / .env.local (siehe lib/env.ts für die Validierung).
# Diese Datei enthält keine echten Werte und wird eingecheckt; .env selbst nicht (.gitignore).

# Vom postgres-Image in docker-compose.yml gelesen (Container-Zugangsdaten). Nur lokal relevant.
POSTGRES_USER=velora
POSTGRES_PASSWORD=velora
POSTGRES_DB=velora

# Pflicht. Verbindung zur PostgreSQL-Datenbank, muss mit postgres:// oder postgresql:// beginnen.
# Lokale Entwicklung passend zu den POSTGRES_*-Werten oben und docker-compose.yml:
DATABASE_URL=postgresql://velora:velora@localhost:5432/velora

# Optional, Standard "development". In Tests setzt Vitest automatisch "test".
NODE_ENV=development

# Ab Phase 1 Pflicht (better-auth signiert Sitzungen damit). In Phase 0 noch ohne Wirkung.
SESSION_SECRET=

# Optional. E-Mail-Adresse, die bei der Ersteinrichtung (Phase 1) automatisch Admin-Rechte
# erhält. Muss, wenn gesetzt, eine gültige E-Mail-Adresse sein.
ADMIN_BOOTSTRAP_EMAIL=
