{
  "name": "velora-casino-demo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --testNamePattern '^((?!RTP-Simulation|PRNG-Simulation|gemessene Verteilung und RTP).)*$'",
    "test:rtp": "vitest run --testNamePattern 'RTP-Simulation|PRNG-Simulation|gemessene Verteilung und RTP'",
    "test:full": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/.bin/drizzle-kit migrate",
    "db:seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-transform-types --experimental-loader=./scripts/ts-alias-loader.mjs server/seed/run-seed.ts",
    "check:concurrency": "node --experimental-transform-types --experimental-loader=./scripts/ts-alias-loader.mjs scripts/concurrency-check.ts",
    "db:backup": "bash scripts/backup-db.sh",
    "db:restore": "bash scripts/restore-db.sh"
  },
  "dependencies": {
    "better-auth": "1.6.30",
    "drizzle-orm": "0.45.2",
    "lucide-react": "0.577.0",
    "next": "15.5.23",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.5",
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "22.20.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "4.7.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.23",
    "eslint-plugin-import": "2.32.0",
    "jsdom": "26.1.0",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
}
}